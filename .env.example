# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# Signs the session cookie (JWT). Required in production, at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Eskiz.uz SMS gateway — https://eskiz.uz
# Leave these empty during development: no SMS is sent and the login code is
# printed to the server console instead.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Approved sender nickname. "4546" is the Eskiz test sender and works before
# your own nickname is approved.
ESKIZ_FROM=4546

# Message body sent to the customer. Must match a template approved by Eskiz.
# {code} is replaced with the 6-digit code.
ESKIZ_SMS_TEMPLATE=DieselParts: tasdiqlash kodi {code}. Kod 5 daqiqa amal qiladi.

# Railway Postgres connection string. Get it with:  railway variables --kv
DATABASE_URL=

# Password for the DIRECTOR account created by `npm run db:seed`.
# The seed refuses to run without it — it never falls back to a literal.
SEED_DIRECTOR_PASSWORD=
