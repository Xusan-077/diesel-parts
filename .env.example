AUTH_SECRET=

ESKIZ_EMAIL=
ESKIZ_PASSWORD=

ESKIZ_FROM=4546

# Must be the exact wording approved in the Eskiz.uz dashboard, with its
# sample digits (e.g. "0000") replaced by the literal placeholder "{code}" —
# see buildOtpMessage in lib/auth/eskiz.ts for why a template missing that
# placeholder is refused outright rather than sent as-is.
ESKIZ_SMS_TEMPLATE=DieselParts.uz saytiga kirish uchun tasdiqlash kodi: {code}. Kodni hech kimga bermang!

# ============================================================================
# ⚠️  DATABASE_URL — NEVER point this at the Railway production Postgres.
#
# On 2026-08-23, DATABASE_URL in this file's local counterpart (.env.local)
# was accidentally set to the SAME connection string as Railway's production
# `Postgres` service (melodious-adventure project, DATABASE_PUBLIC_URL). Every
# `prisma migrate dev` run locally after that point applied schema changes
# directly to the live production database, and one such migration dropped a
# column production's currently-deployed build still depended on — causing a
# same-day production outage (503s on every /api/products/* route). See
# docs/deploy-checklist.md for the incident writeup.
#
# Local dev MUST use its own database, separate from production:
#   - Local Postgres (already used by backend/):
#     DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diesel_parts_web_dev?schema=public"
#   - Or a dedicated Railway "dev"/"staging" Postgres service, never the
#     production one.
#
# Production's DATABASE_URL lives ONLY in Vercel's Environment Variables
# (Production/Preview scope) — it must never be copied into a local .env file.
# ============================================================================
DATABASE_URL=

SEED_DIRECTOR_PASSWORD=

# Base URL of the standalone NestJS backend (backend/) that powers /seller/*.
# Local dev: http://localhost:4000
# Production (set in Vercel Project Settings -> Environment Variables): https://api.diesel-parts.uz
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical site URL, used for absolute links (e.g. metadata, sitemaps).
# Production: https://www.diesel-parts.uz
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob read/write token for director-uploaded product photos
# (lib/api/product-image-storage.ts). Provisioned per-environment by
# `vercel blob create-store` / the Storage tab — pull with `vercel env pull`,
# never hand-copy a token between environments.
BLOB_READ_WRITE_TOKEN=

# Shared secret with the backend (backend/.env's INTERNAL_SERVICE_SECRET) for
# server-to-server calls this app makes to it — currently the product "AI
# bilan" fill and photo-generation proxy routes (lib/api/internal-backend.ts).
# Must be the exact same value in both apps' environments.
INTERNAL_SERVICE_SECRET=

# Microsoft Clarity project ID, clarity.microsoft.com dan olinadi. Faqat
# production build'da ishlaydi (components/analytics/clarity-init.tsx),
# shuning uchun lokal .env.local'da bo'sh qoldirish mumkin.
NEXT_PUBLIC_CLARITY_ID=""

# NOTE: Payme Merchant API keys (PAYME_MERCHANT_ID / PAYME_MERCHANT_KEY) live
# only in backend/.env — this app never calls Payme directly, it just proxies
# /api/v1/checkout to backend/'s CheckoutController. No key needed here.
