# ============================================================================
# ⚠️  DATABASE_URL — NEVER point this at the Railway production Postgres.
#
# This file previously had the real production connection string hardcoded
# here as its "example" value — that's a live credential sitting in a
# template file, and copying it into backend/.env (as happened once already,
# see docs/deploy-checklist.md for the 2026-08-23 incident) migrates a local
# `prisma migrate dev` run straight onto the production database.
#
# Local dev MUST use its own database:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diesel_parts_erp?schema=public"
#
# Production's real DATABASE_URL lives ONLY in Railway's service Variables
# (service `diesel-parts`, environment `production`) — never in a file here.
# ============================================================================
DATABASE_URL=""

PORT=4000

# Railway sets this automatically in the production environment; it also
# gates the `secure` flag on the refresh-token cookie (see auth.controller.ts).
# Set to "production" for any deploy that serves real traffic over HTTPS.
NODE_ENV=development

JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_EXPIRES_IN="7d"

# Shared secret Next.js and the backend both hold to authenticate
# server-to-server calls: a customer's OTP-verified phone number
# (InternalServiceGuard) and the director panel's AI product-fill/image-gen
# calls (InternalRequestGuard). Must be the exact same value in both apps'
# environments.
INTERNAL_SERVICE_SECRET="change-me"

# Comma-separated allowlist of origins allowed to call this API with
# credentials (see main.ts's enableCors). Local dev defaults cover
# localhost:3000; production must include the storefront's real domain(s).
CORS_ORIGINS="http://localhost:3000,https://www.diesel-parts.uz,https://diesel-parts.uz"

# Product "AI bilan" fill (OEM number -> product data via Gemini's Google
# Search grounding) and photo generation (Gemini's image model) — both share
# this one key. Provisioned in Railway's service Variables for production.
GEMINI_API_KEY=""
