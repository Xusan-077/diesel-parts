generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  DIRECTOR
  MANAGER
  SELLER
  VIEWER
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  WON
  LOST
}

enum InquirySource {
  PRODUCT_DIALOG
  QUOTE_FORM
  CONTACT_FORM
}

/// Values match the StockStatus union in lib/types.ts exactly, so the column
/// maps to the domain type with no translation table.
enum StockStatus {
  available
  limited
  out_of_stock
}

enum OrderPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum StockMovementType {
  IN
  OUT
  RESERVE
  RELEASE
  /// Goods receipt approved (Phase 1). The only new value Phase 1 code produces.
  PURCHASE
  /// The rest are declared now so the ledger vocabulary is stable and the enum
  /// is not re-migrated every phase. Not produced by any code until their phase.
  WRITE_OFF
  TRANSFER_IN
  TRANSFER_OUT
  INVENTORY_ADJUSTMENT
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum GoodsReceiptStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  ONLINE
  /// Self-checkout: the shopper asked to settle terms with a manager. The order
  /// is created, no gateway payment is attempted, and a person follows up.
  SELLER_AGREEMENT
}

enum ReturnRefundMethod {
  CASH
  CARD
  TRANSFER
  ONLINE
  SELLER_AGREEMENT
  PAYME
  CLICK
  PAYNET
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

model Brand {
  id       String    @id
  slug     String    @unique
  name     String
  logoUrl  String?
  products Product[]
}

/// A node in the catalog tree. Roots are the mega-menu's columns; their
/// children are the entries under each column, and a product hangs off a leaf.
model Category {
  id        String     @id
  slug      String     @unique
  nameUz    String
  nameRu    String
  nameEn    String
  /// The part family this branch belongs to — "engine", "brakes", "filters".
  ///
  /// A root and every category under it carry the same value, so the family is
  /// answerable without walking the tree. Defaulted rather than required so the
  /// column could be added to a populated table; the seed sets a real value on
  /// every row it writes.
  type      String     @default("general")
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  /// Position among siblings. Ties break on name, so an unset order is stable
  /// rather than arbitrary.
  order     Int        @default(0)
  /// Key of the pictogram the menu draws beside this entry, resolved to a
  /// component by components/catalog/catalog-icon.tsx. Null on a row nobody has
  /// chosen one for; the menu simply draws no mark rather than a placeholder.
  icon      String?
  createdAt DateTime   @default(now())
  products  Product[]

  @@index([parentId, order])
}

model Product {
  id                String             @id
  slug              String             @unique
  sku               String             @unique
  /// Scanned barcode (EAN/UPC or an in-house code). Nullable — unknown on most
  /// existing rows; unique so a scan resolves to exactly one product.
  barcode           String?            @unique
  oemNumbers        String[]
  nameUz            String
  nameRu            String
  nameEn            String
  descriptionUz     String
  descriptionRu     String
  descriptionEn     String
  price             Decimal?           @db.Decimal(14, 2)
  /// Cost side, for margin reporting. SELLER role never sees this
  /// (ProductsService.SELLER_HIDDEN_FIELDS). Nullable — unknown on old rows.
  purchasePrice     Decimal?           @db.Decimal(14, 2)
  currency          String             @default("UZS")
  stock             Int                @default(0)
  minStock          Int                @default(0)
  /// Unit of issue — "dona" (pcs), "litr", "komplekt". Free text for now; a
  /// real unit table is a later concern.
  unit              String             @default("dona")
  /// Target on-hand the warehouse tries to keep. Distinct from minStock (the
  /// reorder trigger); used by future replenishment suggestions.
  recommendedStock  Int                @default(0)
  /// Weighted-average purchase cost across all warehouses, rolled up on every
  /// goods-receipt approval. Null until the first receipt touches the product.
  averageCost       Decimal?           @db.Decimal(14, 2)
  /// Unit cost from the most recent approved receipt line. Null until then.
  lastPurchaseCost  Decimal?           @db.Decimal(14, 2)
  /// Derived from stock/minStock by deriveStockStatus() on every write. Never
  /// accepted from a caller — the repository recomputes it.
  stockStatus       StockStatus
  categoryId        String
  brandId           String
  category          Category           @relation(fields: [categoryId], references: [id])
  brand             Brand              @relation(fields: [brandId], references: [id])
  compatibleModels  String[]
  specs             Json
  /// A photograph's URL, set only through the admin image-upload endpoints
  /// (never through the general write form) — the same "server derives it"
  /// treatment as stockStatus. Null on every row nobody has photographed yet;
  /// the storefront falls back to a placeholder icon for those. One photo per
  /// product today — a `ProductImage` table for a real multi-photo gallery is
  /// a later feature this column does not imply.
  imageUrl          String?
  /// Retired — no code reads it. The column still exists in production only
  /// because the 2026-08-23 hotfix re-added it (see incident section in
  /// docs/deploy-checklist.md); modelled here so schema and DB stay in sync.
  /// Dropping it is a separate, tracked migration, not part of step 2.
  imageLabels       String[]
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  inquiries         Inquiry[]
  orderItems        OrderItem[]
  reviews           Review[]
  inventories       Inventory[]
  cartItems         CartItem[]
  goodsReceiptItems GoodsReceiptItem[]
  returnItems       ReturnItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([stockStatus])
  @@index([stock])
  @@index([isActive, createdAt])
}

/// A buyer's rating of a part they bought.
///
/// Kept as rows rather than as an average on Product: a stored average cannot
/// be recomputed when a review is hidden or deleted, and the catalog needs the
/// count beside it anyway. Aggregated per page, not per row.
model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Whole stars, 1 to 5. A CHECK constraint in the migration enforces the
  /// range in the database, which Prisma's schema language cannot express.
  rating      Int
  /// The reviewer's own words. Nullable so a rating can stand on its own, but
  /// the public endpoint requires text today: a parts review with no words
  /// tells the next buyer nothing.
  body        String?
  /// What the reviewer asked to be called. Not an identity — see authorPhone.
  authorName  String
  /// The verified phone from the session, and the identity behind
  /// `@@unique([productId, authorPhone])`.
  ///
  /// MUST NEVER reach a public payload. The site has no user table for
  /// customers — a session carries a phone number and nothing else — so this
  /// is the only thing that can hold one person to one review per part, and it
  /// is also a personal detail sitting next to a public opinion. Every read
  /// path selects columns explicitly for that reason.
  authorPhone String
  /// Visible on the site. Reviews publish on submission — the phone was
  /// already verified by SMS, which is the spam gate — and a director clears
  /// this to take one down. The catalog aggregates visible rows only, so a
  /// hidden review moves no average.
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())

  /// One review per person per part. A second submission updates the first
  /// rather than being refused, so changing your mind is editing, not a dead
  /// end.
  @@unique([productId, authorPhone])
  @@index([productId, isApproved, createdAt])
  @@index([isApproved, createdAt])
}

model User {
  id                    String                @id @default(cuid())
  name                  String
  email                 String                @unique
  phone                 String?               @unique
  passwordHash          String
  role                  Role
  isActive              Boolean               @default(true)
  /// Percent a SELLER may discount without director approval.
  discountLimit         Int                   @default(5)
  createdAt             DateTime              @default(now())
  /// Added after the table was populated, so it carries a DB default; Prisma
  /// still stamps it on every write via @updatedAt.
  updatedAt             DateTime              @default(now()) @updatedAt
  inquiries             Inquiry[]             @relation("AssignedInquiries")
  assignedCustomers     Customer[]            @relation("AssignedCustomers")
  orders                Order[]               @relation("SellerOrders")
  requestedDiscounts    DiscountRequest[]     @relation("RequestedDiscounts")
  reviewedDiscounts     DiscountRequest[]     @relation("ReviewedDiscounts")
  notifications         Notification[]
  auditLogs             AuditLog[]
  seller                Seller?
  refreshTokens         RefreshToken[]
  stockMovementsMade    StockMovement[]
  managedWarehouses     Warehouse[]           @relation("WarehouseManager")
  goodsReceiptsCreated  GoodsReceipt[]        @relation("GoodsReceiptCreatedBy")
  goodsReceiptsApproved GoodsReceipt[]        @relation("GoodsReceiptApprovedBy")
  createdExpenses       Expense[]             @relation("CreatedExpenses")
  cashierShifts         CashierShift[]
  returnsHandled        Return[]              @relation("SellerReturns")
  debtPaymentsRecorded  CustomerDebtPayment[] @relation("DebtPaymentsRecorded")
}

model Inquiry {
  id               String        @id @default(cuid())
  customerName     String
  phone            String
  email            String?
  message          String
  productId        String?
  product          Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Snapshot so the record stays meaningful if the product is deleted.
  productSku       String?
  quantity         Int?
  status           InquiryStatus @default(NEW)
  source           InquirySource
  assignedSellerId String?
  assignedSeller   User?         @relation("AssignedInquiries", fields: [assignedSellerId], references: [id], onDelete: SetNull)
  /// The seller's own running note on the lead. Free text, not shown publicly.
  notes            String?
  /// When the seller means to call back. Null means nothing is scheduled.
  followUpAt       DateTime?
  orders           Order[]
  createdAt        DateTime      @default(now())

  @@index([status, createdAt])
  @@index([assignedSellerId])
  @@index([followUpAt])
}

enum OrderStatus {
  DRAFT
  NEW
  PENDING
  CONFIRMED
  PREPARING
  COMPLETED
  CANCELLED
  /// A return left some of the order's value refunded, some kept.
  PARTIALLY_REFUNDED
  /// Every returnable line has been returned; the sale is fully reversed.
  REFUNDED
}

enum CashierShiftStatus {
  OPEN
  CLOSED
}

enum ReturnReason {
  WRONG_PRODUCT
  DEFECTIVE
  CHANGED_MIND
  DAMAGED
  OTHER
}

enum ReturnCondition {
  GOOD
  DAMAGED
  USED
  DEFECTIVE
}

enum ReturnStatus {
  COMPLETED
  CANCELLED
}

enum DiscountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  LOW_STOCK
  NEW_INQUIRY
  DISCOUNT_REQUESTED
  DISCOUNT_DECIDED
  ORDER_STATUS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  IMPORT
  LOGIN
  /// A staff-recorded payment against an order (finance module — debt tab).
  PAYMENT
}

enum ExpenseCategory {
  RENT
  SALARY
  UTILITIES // kommunal
  LOGISTICS // yetkazib berish / transport
  TAX // soliq
  SUPPLIES // xo'jalik / kanstovarlar
  MARKETING
  BANK // bank xizmati / komissiya
  OTHER
}

/// A buyer a seller works with repeatedly. Distinct from Inquiry, which records
/// one anonymous approach from the public site and may never become a Customer.
model Customer {
  id               String                @id @default(cuid())
  name             String
  /// Not unique: a company's switchboard number is shared by several contacts.
  phone            String
  email            String?
  company          String?
  /// INN — the Uzbek taxpayer id, for a B2B checkout's invoice. Free text.
  taxId            String?
  telegram         String?
  notes            String?
  /// Running balance owed by this buyer (warehouse/POS side). Non-null, starts
  /// at 0 — the checkout and payment flows adjust it.
  debt             Decimal               @default(0) @db.Decimal(14, 2)
  /// Ceiling on `debt`. 0 (the default) means the customer is not allowed to
  /// carry any debt at all — a sale that would leave them owing anything is
  /// refused unless a director raises this first.
  debtLimit        Decimal               @default(0) @db.Decimal(14, 2)
  /// Null means unassigned — visible to directors, claimable by any seller.
  assignedSellerId String?
  assignedSeller   User?                 @relation("AssignedCustomers", fields: [assignedSellerId], references: [id], onDelete: SetNull)
  orders           Order[]
  debtPayments     CustomerDebtPayment[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([assignedSellerId])
  @@index([phone])
}

model Order {
  id                       String             @id @default(cuid())
  /// Human-readable reference quoted to the customer, e.g. "DP-2026-0042".
  orderNumber              String             @unique
  customerId               String
  customer                 Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sellerId                 String
  seller                   User               @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  status                   OrderStatus        @default(DRAFT)
  currency                 String             @default("UZS")
  /// Sum of the line items before any discount. Stored rather than derived so a
  /// later price change on the product cannot rewrite a historical order.
  subtotal                 Decimal            @db.Decimal(14, 2)
  /// Flat-amount discount (POS quick-sale). Separate from the percent workflow
  /// below — the two serve different flows.
  discount                 Decimal            @default(0) @db.Decimal(14, 2)
  deliveryFee              Decimal            @default(0) @db.Decimal(14, 2)
  /// Percent the seller asked for. Within their User.discountLimit it applies
  /// immediately; above it, a DiscountRequest gates approval.
  discountRequestedPercent Decimal            @default(0) @db.Decimal(5, 2)
  /// Percent actually in force. Equals the requested percent once approved.
  discountApprovedPercent  Decimal            @default(0) @db.Decimal(5, 2)
  /// subtotal minus discountApprovedPercent, recomputed on every write.
  totalAmount              Decimal            @db.Decimal(14, 2)
  paymentStatus            OrderPaymentStatus @default(UNPAID)
  /// Self-checkout only. DELIVERY requires the address columns below; enforced
  /// in CreateCheckoutDto, not at the DB level.
  deliveryMethod           DeliveryMethod     @default(PICKUP)
  deliveryCity             String?
  deliveryDistrict         String?
  deliveryStreet           String?
  deliveryNotes            String?
  /// Structured self-checkout address, added alongside the flat columns above.
  /// A DELIVERY order fills `deliveryRegion` + `deliveryHouse` (required in the
  /// DTO); apartment and landmark are optional. All nullable so orders created
  /// before this block existed are untouched. Coordinates are a later step —
  /// `deliveryLatitude` / `deliveryLongitude` will slot in here.
  deliveryRegion           String?
  deliveryHouse            String?
  deliveryApartment        String?
  deliveryLandmark         String?
  /// The contact number for THIS order, canonical `998XXXXXXXXX`. May differ
  /// from the account's verified number — someone ordering for delivery to a
  /// colleague. Nullable: pre-existing orders have none.
  contactPhone             String?
  notes                    String?
  /// Null until a CRM order is confirmed and inventory needs reserving; a POS
  /// order sets it up front.
  warehouseId              String?
  warehouse                Warehouse?         @relation(fields: [warehouseId], references: [id])
  /// Set when the order was raised from a board card, so the conversion figure
  /// is counted rather than estimated and one inquiry cannot be billed twice.
  inquiryId                String?
  inquiry                  Inquiry?           @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  items                    OrderItem[]
  discountRequests         DiscountRequest[]
  payments                 Payment[]
  invoice                  Invoice?
  returns                  Return[]
  /// Set once, the first time a COMPLETED order is left with an outstanding
  /// balance and that balance is added to `Customer.debt`. Guards that accrual
  /// from ever running twice on the same order (e.g. a retried request).
  debtSettledAt            DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([sellerId, status])
  @@index([customerId])
  @@index([status, createdAt])
  @@index([inquiryId])
  @@index([warehouseId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Snapshots, so the line still reads correctly after the product is renamed
  /// or repriced. Same pattern as Inquiry.productSku.
  productSku  String
  productName String
  qty         Int
  unitPrice   Decimal @db.Decimal(14, 2)

  @@index([orderId])
  @@index([productId])
}

model DiscountRequest {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           User           @relation("RequestedDiscounts", fields: [sellerId], references: [id], onDelete: Restrict)
  requestedPercent Decimal        @db.Decimal(5, 2)
  reason           String?
  status           DiscountStatus @default(PENDING)
  reviewedByUserId String?
  reviewedBy       User?          @relation("ReviewedDiscounts", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  decisionNote     String?
  createdAt        DateTime       @default(now())

  @@index([status, createdAt])
  @@index([sellerId])
  @@index([orderId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  /// Id of the row the notification points at — order, inquiry or product.
  /// Untyped on purpose: the type field says which table to read it against.
  entityId  String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  /// Null once the acting user is deleted; the trail itself must survive.
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String
  entityId   String
  before     Json?
  after      Json?
  /// Client IP of the request that triggered the action, when the caller passes
  /// it. Null for background actions and every row written before this column.
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Warehouse {
  id        String          @id @default(cuid())
  name      String
  /// Short unique handle ("W1", "MARKAZ"). Required; the migration backfills
  /// existing rows "W1", "W2", … by createdAt before adding the constraint.
  code      String          @unique
  /// Postal / physical address. `location` (a looser label) is kept for
  /// back-compat; `address` is the structured field the warehouse panel edits.
  location  String?
  address   String?
  managerId String?
  manager   User?           @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  status    WarehouseStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  sellers        Seller[]
  inventories    Inventory[]
  orders         Order[]
  stockMovements StockMovement[]
  goodsReceipts  GoodsReceipt[]
  cashierShifts  CashierShift[]

  @@index([managerId])
}

/// availableQuantity is deliberately NOT a column — it is always derived as
/// (quantity - reservedQuantity) in application code, so it can never drift.
model Inventory {
  id               String    @id @default(cuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  quantity         Int       @default(0)
  reservedQuantity Int       @default(0)
  /// Per-warehouse weighted-average cost, rolled up on goods-receipt approval.
  /// `Product.averageCost` is the global roll-up across warehouses. Null until
  /// the first receipt touches this row.
  averageCost      Decimal?  @db.Decimal(14, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  stockMovements StockMovement[]

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model StockMovement {
  id            String            @id @default(cuid())
  inventoryId   String
  inventory     Inventory         @relation(fields: [inventoryId], references: [id])
  type          StockMovementType
  quantity      Int
  reason        String?
  /// On-hand quantity of the inventory row immediately after this movement.
  /// Null on legacy rows written before the ledger tracked it.
  balanceAfter  Int?
  /// What produced this movement — "GoodsReceipt", "Order", "WriteOff", …
  referenceType String?
  /// Id of that row.
  referenceId   String?
  /// Cost carried by this movement (receipt line unit cost for PURCHASE).
  unitCost      Decimal?          @db.Decimal(14, 2)
  /// Denormalised from `inventory.warehouseId` so the ledger can be queried by
  /// warehouse directly. Set on every new write; null on legacy rows.
  warehouseId   String?
  warehouse     Warehouse?        @relation(fields: [warehouseId], references: [id])
  createdById   String?
  createdBy     User?             @relation(fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())

  @@index([inventoryId])
  @@index([createdAt])
  @@index([referenceType, referenceId])
  @@index([warehouseId, createdAt])
}

/// Single-row counter used inside a transaction (SELECT ... FOR UPDATE) to hand
/// out sequential, gapless-per-attempt order numbers without racing.
model OrderSequence {
  id         Int @id @default(1)
  lastNumber Int @default(1000)
}

/// A stock intake document. Created DRAFT, edited freely, then APPROVED once —
/// approval is the only thing that moves stock (one PURCHASE StockMovement per
/// line, inside a transaction). Never hard-deleted: a mistake becomes CANCELLED.
model GoodsReceipt {
  id            String             @id @default(cuid())
  /// Auto-assigned on create: "GR-<YYYY>-<NNNN>", NNNN a gapless global counter
  /// from GoodsReceiptSequence. YYYY is display only, not reset per year.
  receiptNumber String             @unique
  warehouseId   String
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  /// Free text — no Supplier model yet (Phase 1 scope).
  supplierName  String?
  status        GoodsReceiptStatus @default(DRAFT)
  /// Money columns, all recomputed server-side from the items on every write.
  subtotal      Decimal            @default(0) @db.Decimal(14, 2)
  discount      Decimal            @default(0) @db.Decimal(14, 2)
  tax           Decimal            @default(0) @db.Decimal(14, 2)
  total         Decimal            @default(0) @db.Decimal(14, 2)
  note          String?
  createdById   String
  createdBy     User               @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id])
  approvedById  String?
  approvedBy    User?              @relation("GoodsReceiptApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  items         GoodsReceiptItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([warehouseId, status])
  @@index([status, createdAt])
}

model GoodsReceiptItem {
  id             String       @id @default(cuid())
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Int
  unitCost       Decimal      @db.Decimal(14, 2)
  /// quantity * unitCost, recomputed on every write.
  lineTotal      Decimal      @db.Decimal(14, 2)

  @@index([goodsReceiptId])
  @@index([productId])
}

/// Single-row counter for gapless receipt numbering — same pattern as
/// OrderSequence (atomic upsert-increment inside the create transaction).
model GoodsReceiptSequence {
  id         Int @id @default(1)
  lastNumber Int @default(0)
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount             Decimal       @db.Decimal(14, 2)
  method             PaymentMethod
  status             PaymentStatus @default(PENDING)
  /// Null for the existing staff-recorded (cash/card/transfer) payments;
  /// "payme" for gateway payments.
  provider           String?
  /// The provider's own id for this attempt. Only PaymeService (driven by
  /// Payme's webhook) may move a payment to COMPLETED.
  transactionId      String?
  /// Payme's `time` (epoch ms) from CreateTransaction, echoed back verbatim on
  /// every retry to keep CreateTransaction idempotent.
  providerCreateTime BigInt?
  cancelledAt        DateTime?
  /// Payme's CancelTransaction `reason` code — support/audit only.
  cancelReason       Int?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  /// Guards webhook idempotency. Postgres treats each NULL as distinct, so the
  /// staff-recorded rows (provider/transactionId both null) are unaffected.
  @@unique([provider, transactionId])
  @@index([orderId])
}

/// A cashier's session at the till — opened with a counted float, closed with
/// a counted actual, the gap between actual and expected surfacing as
/// `difference`. One seller has at most one OPEN shift at a time (enforced in
/// CashierService, not the schema).
model CashierShift {
  id                   String             @id @default(cuid())
  sellerId             String
  seller               User               @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  warehouseId          String?
  warehouse            Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  status               CashierShiftStatus @default(OPEN)
  openingBalance       Decimal            @db.Decimal(14, 2)
  /// The counted cash the seller reports at close time.
  closingBalanceActual Decimal?           @db.Decimal(14, 2)
  /// openingBalance + cash sales - cash refunds over the shift window,
  /// computed and stored at close time.
  expectedBalance      Decimal?           @db.Decimal(14, 2)
  /// closingBalanceActual - expectedBalance. Positive: a cash surplus.
  difference           Decimal?           @db.Decimal(14, 2)
  comment              String?
  openedAt             DateTime           @default(now())
  closedAt             DateTime?

  @@index([sellerId, status])
  @@index([openedAt])
}

/// A customer returning some (or all) of a COMPLETED order's items. Only
/// `GOOD`-condition lines go back on the shelf; the rest are recorded but
/// never touch StockMovement. `refundAmount` defaults to the returned lines'
/// total; a seller may reduce it when agreeing an adjusted refund.
model Return {
  id           String        @id @default(cuid())
  /// "RET-<N>", same gapless-sequence pattern as Order.orderNumber.
  returnNumber String        @unique
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerId     String
  seller       User          @relation("SellerReturns", fields: [sellerId], references: [id], onDelete: Restrict)
  refundMethod ReturnRefundMethod
  refundAmount Decimal       @db.Decimal(14, 2)
  status       ReturnStatus  @default(COMPLETED)
  items        ReturnItem[]
  createdAt    DateTime      @default(now())

  @@index([orderId])
  @@index([sellerId, createdAt])
}

model ReturnItem {
  id        String          @id @default(cuid())
  returnId  String
  return    Return          @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty       Int
  unitPrice Decimal         @db.Decimal(14, 2)
  /// qty * unitPrice.
  lineTotal Decimal         @db.Decimal(14, 2)
  reason    ReturnReason
  condition ReturnCondition

  @@index([returnId])
  @@index([productId])
}

/// A customer paying down their running `Customer.debt` balance — not tied to
/// any one order, unlike `Payment`. Purely additive bookkeeping: the balance
/// itself lives on `Customer.debt` and is decremented when this is created.
model CustomerDebtPayment {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount     Decimal       @db.Decimal(14, 2)
  method     PaymentMethod
  comment    String?
  sellerId   String
  seller     User          @relation("DebtPaymentsRecorded", fields: [sellerId], references: [id], onDelete: Restrict)
  createdAt  DateTime      @default(now())

  @@index([customerId, createdAt])
}

/// Single-row counter for gapless return numbering — same pattern as OrderSequence.
model ReturnSequence {
  id         Int @id @default(1)
  lastNumber Int @default(0)
}

/// A bookkeeping line for money that left the business — the "Xarajatlar" tab
/// of the finance module. Hard-deleted when wrong (a mis-typed line is removed,
/// not archived); every create/update/delete is audited.
model Expense {
  id          String          @id @default(cuid())
  /// Short human title, e.g. "Sentyabr ijara".
  title       String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(14, 2)
  /// The day the money left, not the day the row was entered. Stored at
  /// Tashkent midnight (UTC+5) by the service.
  spentAt     DateTime
  note        String?
  createdById String
  createdBy   User            @relation("CreatedExpenses", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([spentAt])
  @@index([category, spentAt])
}

model Invoice {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber String   @unique
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// A phone-verified storefront visitor's cart. Keyed by phone — backend/ has no
/// concept of a storefront visitor's identity beyond the OTP session, and a
/// Customer row is only created at checkout.
model Cart {
  id        String     @id @default(cuid())
  phone     String     @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([cartId, productId])
}

/// Refresh tokens are stored hashed (bcrypt) and rotated on every /auth/refresh.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Seller {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([warehouseId])
}
