# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev_server.log
build_output.txt

# env files (can opt-in for committing if needed)
.env*
# ...except the checked-in template, which holds no real values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma — generated client is build output, regenerated by postinstall
/prisma/generated/

# stale Claude Code worktree checkouts (each carries its own .git pointer)
/.claude/worktrees/

# SSH keypairs left behind by `railway connect Postgres --tunnel-only`, which
# names its key after the command. Private material; never commit it.
/railway connect Postgres*

# director-uploaded product photos — written at runtime by the image-upload
# endpoints, not build output. Seed photos live in /public/seed-images instead,
# which IS committed, so a fresh checkout's catalog is never missing images.
/public/uploads/

# pre-migration database dumps (scripts/migrate-web-dev-to-erp.ts --apply).
# Full data dumps, real (non-production) dev rows — never commit them.
/scripts/backups/
