# This is now a two-app repo (frontend/, backend/), each with its own
# self-contained .gitignore. Only root-level concerns live here.

# leftover from before the frontend/ restructure — a locked file (IDE/TS
# server) blocked moving it into frontend/node_modules; safe to delete by
# hand once nothing holds it open. frontend/ has its own, freshly installed.
/node_modules

# misc
.DS_Store
*.pem

# stale Claude Code worktree checkouts (each carries its own .git pointer)
/.claude/worktrees/

# SSH keypairs left behind by `railway connect Postgres --tunnel-only`, which
# names its key after the command. Private material; never commit it.
/railway connect Postgres*

# pre-migration database dumps (scripts/migrate-web-dev-to-erp.ts --apply).
# Full data dumps, real (non-production) dev rows, password hashes — never commit them.
/scripts/backups/
