generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DIRECTOR
  SELLER
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  WON
  LOST
}

enum InquirySource {
  PRODUCT_DIALOG
  QUOTE_FORM
  CONTACT_FORM
}

/// Values match the StockStatus union in lib/types.ts exactly, so the column
/// maps to the domain type with no translation table.
enum StockStatus {
  available
  limited
  out_of_stock
}

model Brand {
  id       String    @id
  slug     String    @unique
  name     String
  logoUrl  String?
  products Product[]
}

/// A node in the catalog tree. Roots are the mega-menu's columns; their
/// children are the entries under each column, and a product hangs off a leaf.
model Category {
  id     String @id
  slug   String @unique
  nameUz String
  nameRu String
  nameEn String
  /// The part family this branch belongs to — "engine", "brakes", "filters".
  ///
  /// A root and every category under it carry the same value, so the family is
  /// answerable without walking the tree. Defaulted rather than required so the
  /// column could be added to a populated table; the seed sets a real value on
  /// every row it writes.
  type      String     @default("general")
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  /// Position among siblings. Ties break on name, so an unset order is stable
  /// rather than arbitrary.
  order     Int        @default(0)
  /// Key of the pictogram the menu draws beside this entry, resolved to a
  /// component by components/catalog/catalog-icon.tsx. Null on a row nobody has
  /// chosen one for; the menu simply draws no mark rather than a placeholder.
  icon      String?
  createdAt DateTime   @default(now())
  products  Product[]

  @@index([parentId, order])
}

model Product {
  id               String      @id
  slug             String      @unique
  sku              String      @unique
  oemNumbers       String[]
  nameUz           String
  nameRu           String
  nameEn           String
  descriptionUz    String
  descriptionRu    String
  descriptionEn    String
  price            Decimal?    @db.Decimal(14, 2)
  currency         String      @default("UZS")
  stock            Int         @default(0)
  minStock         Int         @default(0)
  /// Derived from stock/minStock by deriveStockStatus() on every write. Never
  /// accepted from a caller — the repository recomputes it.
  stockStatus      StockStatus
  categoryId       String
  brandId          String
  category         Category    @relation(fields: [categoryId], references: [id])
  brand            Brand       @relation(fields: [brandId], references: [id])
  compatibleModels String[]
  specs            Json
  /// A photograph's URL, set only through the admin image-upload endpoints
  /// (never through the general write form) — the same "server derives it"
  /// treatment as stockStatus. Null on every row nobody has photographed yet;
  /// the storefront falls back to a placeholder icon for those. One photo per
  /// product today — a `ProductImage` table for a real multi-photo gallery is
  /// a later feature this column does not imply.
  imageUrl         String?
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  inquiries        Inquiry[]
  orderItems       OrderItem[]
  reviews          Review[]
  cartItems        CartItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([stockStatus])
  @@index([stock])
  @@index([isActive, createdAt])
}

/// A buyer's rating of a part they bought.
///
/// Kept as rows rather than as an average on Product: a stored average cannot
/// be recomputed when a review is hidden or deleted, and the catalog needs the
/// count beside it anyway. Aggregated per page, not per row.
model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Whole stars, 1 to 5. A CHECK constraint in the migration enforces the
  /// range in the database, which Prisma's schema language cannot express.
  rating      Int
  /// The reviewer's own words. Nullable so a rating can stand on its own, but
  /// the public endpoint requires text today: a parts review with no words
  /// tells the next buyer nothing.
  body        String?
  /// What the reviewer asked to be called. Not an identity — see authorPhone.
  authorName  String
  /// The verified phone from the session, and the identity behind
  /// `@@unique([productId, authorPhone])`.
  ///
  /// MUST NEVER reach a public payload. The site has no user table for
  /// customers — a session carries a phone number and nothing else — so this
  /// is the only thing that can hold one person to one review per part, and it
  /// is also a personal detail sitting next to a public opinion. Every read
  /// path selects columns explicitly for that reason.
  authorPhone String
  /// Visible on the site. Reviews publish on submission — the phone was
  /// already verified by SMS, which is the spam gate — and a director clears
  /// this to take one down. The catalog aggregates visible rows only, so a
  /// hidden review moves no average.
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())

  /// One review per person per part. A second submission updates the first
  /// rather than being refused, so changing your mind is editing, not a dead
  /// end.
  @@unique([productId, authorPhone])
  @@index([productId, isApproved, createdAt])
  @@index([isApproved, createdAt])
}

model User {
  id                 String            @id @default(cuid())
  name               String
  email              String            @unique
  phone              String?           @unique
  passwordHash       String
  role               Role
  isActive           Boolean           @default(true)
  /// Percent a SELLER may discount without director approval.
  discountLimit      Int               @default(5)
  createdAt          DateTime          @default(now())
  inquiries          Inquiry[]         @relation("AssignedInquiries")
  assignedCustomers  Customer[]        @relation("AssignedCustomers")
  orders             Order[]           @relation("SellerOrders")
  requestedDiscounts DiscountRequest[] @relation("RequestedDiscounts")
  reviewedDiscounts  DiscountRequest[] @relation("ReviewedDiscounts")
  notifications      Notification[]
  auditLogs          AuditLog[]
}

model Inquiry {
  id               String        @id @default(cuid())
  customerName     String
  phone            String
  email            String?
  message          String
  productId        String?
  product          Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Snapshot so the record stays meaningful if the product is deleted.
  productSku       String?
  quantity         Int?
  status           InquiryStatus @default(NEW)
  source           InquirySource
  assignedSellerId String?
  assignedSeller   User?         @relation("AssignedInquiries", fields: [assignedSellerId], references: [id], onDelete: SetNull)
  /// The seller's own running note on the lead. Free text, not shown publicly.
  notes            String?
  /// When the seller means to call back. Null means nothing is scheduled.
  followUpAt       DateTime?
  orders           Order[]
  createdAt        DateTime      @default(now())

  @@index([status, createdAt])
  @@index([assignedSellerId])
  @@index([followUpAt])
}

enum OrderStatus {
  DRAFT
  PENDING
  PAYMENT_PENDING
  PAYMENT_FAILED
  PAID
  CONFIRMED
  PROCESSING
  READY_FOR_SHIPMENT
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum DiscountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderChannel {
  STAFF
  ONLINE
}

enum PaymentMethod {
  ONLINE
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  PENDING_VERIFICATION
}

enum DeliveryMethod {
  STANDARD
  EXPRESS
  PICKUP
}

enum NotificationType {
  LOW_STOCK
  NEW_INQUIRY
  DISCOUNT_REQUESTED
  DISCOUNT_DECIDED
  ORDER_STATUS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  IMPORT
  LOGIN
}

/// A buyer a seller works with repeatedly. Distinct from Inquiry, which records
/// one anonymous approach from the public site and may never become a Customer.
model Customer {
  id               String   @id @default(cuid())
  name             String
  /// Not unique: a company's switchboard number is shared by several contacts.
  phone            String
  email            String?
  company          String?
  notes            String?
  /// Null means unassigned — visible to directors, claimable by any seller.
  assignedSellerId String?
  assignedSeller   User?    @relation("AssignedCustomers", fields: [assignedSellerId], references: [id], onDelete: SetNull)
  orders           Order[]
  addresses        Address[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([assignedSellerId])
  @@index([phone])
}

model Order {
  id                       String            @id @default(cuid())
  /// Human-readable reference quoted to the customer, e.g. "DP-2026-0042".
  orderNumber              String            @unique
  customerId               String
  customer                 Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sellerId                 String
  seller                   User              @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  status                   OrderStatus       @default(DRAFT)
  currency                 String            @default("UZS")
  /// Sum of the line items before any discount. Stored rather than derived so a
  /// later price change on the product cannot rewrite a historical order.
  subtotal                 Decimal           @db.Decimal(14, 2)
  /// Percent the seller asked for. Within their User.discountLimit it applies
  /// immediately; above it, a DiscountRequest gates approval.
  discountRequestedPercent Decimal           @default(0) @db.Decimal(5, 2)
  /// Percent actually in force. Equals the requested percent once approved.
  discountApprovedPercent  Decimal           @default(0) @db.Decimal(5, 2)
  /// subtotal minus discountApprovedPercent, recomputed on every write.
  totalAmount              Decimal           @db.Decimal(14, 2)
  notes                    String?
  /// Set when the order was raised from a board card, so the conversion figure
  /// is counted rather than estimated and one inquiry cannot be billed twice.
  inquiryId                String?
  inquiry                  Inquiry?          @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  items                    OrderItem[]
  discountRequests         DiscountRequest[]
  channel                  OrderChannel      @default(STAFF)
  paymentMethod            PaymentMethod?
  paymentStatus            PaymentStatus?
  deliveryMethod           DeliveryMethod?
  /// Added on top of totalAmount at checkout time; never folded into it, so
  /// totalAmount keeps meaning exactly what the discount math already expects.
  deliveryFee              Decimal           @default(0) @db.Decimal(14, 2)
  addressId                String?
  address                  Address?          @relation(fields: [addressId], references: [id], onDelete: SetNull)
  payments                 Payment[]
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([sellerId, status])
  @@index([customerId])
  @@index([status, createdAt])
  @@index([inquiryId])
  @@index([channel, status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Snapshots, so the line still reads correctly after the product is renamed
  /// or repriced. Same pattern as Inquiry.productSku.
  productSku  String
  productName String
  qty         Int
  unitPrice   Decimal @db.Decimal(14, 2)

  @@index([orderId])
  @@index([productId])
}

model DiscountRequest {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           User           @relation("RequestedDiscounts", fields: [sellerId], references: [id], onDelete: Restrict)
  requestedPercent Decimal        @db.Decimal(5, 2)
  reason           String?
  status           DiscountStatus @default(PENDING)
  reviewedByUserId String?
  reviewedBy       User?          @relation("ReviewedDiscounts", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  decisionNote     String?
  createdAt        DateTime       @default(now())

  @@index([status, createdAt])
  @@index([sellerId])
  @@index([orderId])
}

/// A payment attempt against an order. An order may have more than one row
/// here — a failed card attempt followed by a retry, for instance — so the
/// order's own paymentStatus (the current answer) is distinct from a payment
/// row's status (that attempt's answer).
model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  amount        Decimal       @db.Decimal(14, 2)
  status        PaymentStatus @default(PENDING)
  /// "payme" | "click", null for a bank transfer.
  provider      String?
  /// The provider's own id for this attempt. Only the provider's webhook may
  /// ever move a payment to SUCCESS.
  transactionId String?
  /// Bank-transfer receipt upload (Vercel Blob URL), null for online payments.
  receiptUrl    String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
  /// Guards webhook idempotency: a provider retrying the same callback must
  /// not be able to create a second row for one transaction and re-fire a
  /// PAID transition. Postgres treats each NULL as distinct here, so the many
  /// bank-transfer rows with no transactionId are unaffected.
  @@unique([provider, transactionId])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Optional nickname ("Home", "Warehouse #2"); not required by checkout.
  label      String?
  country    String
  region     String
  city       String
  line       String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  orders     Order[]

  @@index([customerId])
}

/// A logged-in shopper's cart, one row per phone. There is no customer login
/// beyond the OTP session (lib/auth/session.ts) today, so phone — the same
/// identity a session already carries — is the only key available; it is not
/// linked to Customer because a Customer row is only created at checkout.
model Cart {
  id        String     @id @default(cuid())
  phone     String     @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([cartId, productId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  /// Id of the row the notification points at — order, inquiry or product.
  /// Untyped on purpose: the type field says which table to read it against.
  entityId  String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  /// Null once the acting user is deleted; the trail itself must survive.
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}
